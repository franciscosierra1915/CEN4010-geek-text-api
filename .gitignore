# =============================================================================
#  Geek Text API — .gitignore
#  Node.js + Express + Prisma + PostgreSQL project
#  CEN 4010 — Group 9, Florida International University
# =============================================================================

# =============================================================================
#  Node.js
# =============================================================================

# Dependencies installed by npm — never commit this folder.
# Each developer runs "npm install" locally to generate their own copy.
node_modules/

# npm debug logs generated when an install fails
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Lock files for package managers other than npm (we use npm)
yarn.lock
pnpm-lock.yaml

# =============================================================================
#  Environment Variables  ← CRITICAL: never commit secrets
# =============================================================================

# The .env file contains your DATABASE_URL and other secrets.
# Every developer creates their own .env locally — it must never be pushed.
.env

# Variants used in different environments (all ignored for safety)
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# =============================================================================
#  Prisma
# =============================================================================

# Prisma generates a JavaScript client from your schema into node_modules.
# The generated client is rebuilt by "npx prisma generate" — no need to track it.
# (node_modules is already ignored above, but this is explicit for clarity)
prisma/generated/

# =============================================================================
#  Build Output
# =============================================================================

# Compiled/transpiled output (if you add a build step later)
dist/
build/
out/

# =============================================================================
#  Logs & Runtime Files
# =============================================================================

*.log
logs/
*.pid
*.seed
*.pid.lock

# =============================================================================
#  Testing & Coverage
# =============================================================================

# Test coverage reports generated by tools like Jest or NYC
coverage/
.nyc_output/

# =============================================================================
#  OS-Generated Files
# =============================================================================

# macOS metadata files — created automatically by Finder, never useful in a repo
.DS_Store
.AppleDouble
.LSOverride

# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
#  IDE & Editor Files
# =============================================================================

# VS Code workspace settings (personal preferences — not shared project config)
.vscode/
!.vscode/extensions.json

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/
*.iml

# Vim / Emacs swap files
*.swp
*.swo
*~

# =============================================================================
#  Temporary Files
# =============================================================================

tmp/
temp/
